CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override TTS voice (default is Tabitha)
# TTS_VOICE_ID=b56c6aac-f35f-46f7-9361-e8f078cec72e

# For Cartesia Line voice agent (after cartesia deploy)
# CARTESIA_AGENT_ID=  # Set via cartesia env or from deploy output

# Notion API (create integration at notion.so/my-integrations, share pages with it)
NOTION_API_KEY=
# Required for run_manual: page ID or URL to create test content under
NOTION_PARENT_ID=
# Optional: for 30-day Simple Monthly Planner. Duplicate the template to your workspace
# (https://elemental-accordion-08e.notion.site/The-2026-Simple-Monthly-Planner-2f0edf44cfc580dfbe7ac823fbee8be6),
# share with the integration, then set the duplicated page ID here. Without this, the agent falls back to a basic database calendar.
# NOTION_CALENDAR_TEMPLATE_ID=2f0edf44cfc580dfbe7ac823fbee8be6

# Optional: for run_calendar script - backend URL and custom prompt override
# BACKEND_URL=http://localhost:8000
# CALENDAR_PROMPT=2f0edf44cfc580dfbe7ac823fbee8be6